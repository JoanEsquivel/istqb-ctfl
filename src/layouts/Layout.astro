---
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href={`${base}/`} class="flex items-center gap-2 font-semibold text-slate-900">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">FL</span>
          <span>
            ISTQB CTFL Practice
            <span class="ml-1.5 hidden rounded-md bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-500 sm:inline">Foundation Level v4.0</span>
          </span>
        </a>
        <div class="flex items-center gap-6 text-sm font-medium text-slate-600">
          <a href={`${base}/`} class="transition-colors hover:text-slate-900">Home</a>
          <a href={`${base}/history/`} class="transition-colors hover:text-slate-900">History</a>
        </div>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6">
      <slot />
    </main>
    <footer class="mt-12 border-t border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-1.5 px-4 py-6 text-sm text-slate-500 sm:px-6">
        <p>
          Ready for the real thing? Exam registration, syllabus, and official information:
          <a
            href="https://istqb.org/certifications/certified-tester-foundation-level-ctfl-v4-0/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-indigo-600 hover:underline"
          >
            ISTQB® Certified Tester Foundation Level (CTFL) v4.0 →
          </a>
        </p>
        <p class="text-xs text-slate-400">
          Unofficial practice tool. Exam content © ISTQB®. Not affiliated with or endorsed by ISTQB.
        </p>
      </div>
    </footer>
  </body>
</html>
